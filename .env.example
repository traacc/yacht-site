APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@carter30.pro"
MAIL_FROM_NAME="Carter30.pro"

# Оформление писем: имя в шапке/копирайте и логотип (растровый, из public/).
# Адрес сайта в копирайте берётся из APP_URL — его обязательно задать на проде.
MAIL_BRAND_NAME="CarterPro"
MAIL_BRAND_LOGO="images/logo-email.png"

FEEDBACK_NOTIFICATION_EMAIL="admin@yacht-association.ru"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram-бот для автопостинга новостей
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Прокси для Telegram API: socks5://user:pass@host:1080 или http://host:3128
TELEGRAM_PROXY=
# Имя бота без @ — для deep-link привязки уведомлений (t.me/<bot>?start=<токен>)
TELEGRAM_BOT_USERNAME=
# Секрет вебхука: любая случайная строка, задаётся командой telegram:set-webhook
TELEGRAM_WEBHOOK_SECRET=

# ВКонтакте для автопостинга новостей (VK ID, refresh-token flow).
# Приложение VK ID (настройки приложения на id.vk.com):
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Стартовый refresh-токен пользователя-администратора сообщества
# (scope wall,photos). VK ротирует его при каждом обновлении —
# актуальное значение далее хранится в БД (таблица settings, группа vk).
VK_REFRESH_TOKEN=
# device_id из VK ID (если требуется приложением):
VK_DEVICE_ID=
# Необязательно: статический access token в обход refresh-flow.
VK_ACCESS_TOKEN=
# ID сообщества (положительное число, без минуса)
VK_GROUP_ID=
VK_API_VERSION=5.199
# Прокси для VK API: socks5://user:pass@host:1080 или http://host:3128
VK_PROXY=

# AI-поиск новостей парусного спорта (OpenAI Responses API + web search)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_NEWS_MODEL=gpt-5-mini
OPENAI_NEWS_TIMEOUT=120
OPENAI_NEWS_MAX_OUTPUT_TOKENS=12000
